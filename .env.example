# Copy this file to .env and fill in real values. Keep credentials out of source control.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require
SESSION_SECRET=change-me-to-a-long-random-string
# Generate with: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.com
PORT=3000

# Anthropic API key for "Categorize using AI" (Learning Suite classes). Leave blank to disable that option.
ANTHROPIC_API_KEY=

# Sync limits. Each class can be synced once every SYNC_COOLDOWN_HOURS (default 3;
# 0 turns the limit off, handy on localhost). A reminder to sync appears after
# SYNC_REMINDER_HOURS without one (default 48). Leave blank for the defaults.
SYNC_COOLDOWN_HOURS=
SYNC_REMINDER_HOURS=
