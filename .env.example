# Copy this file to .env and fill in real values. .env is git-ignored.

# Supabase Postgres connection string.
# Dashboard -> Connect -> Session pooler (port 5432). Keep ?sslmode=require on the end.
DATABASE_URL=postgresql://postgres.PROJECT_REF:YOUR_PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres?sslmode=require

# Any long random string. Used to sign the session cookie.
SESSION_SECRET=change-me-to-a-long-random-string

# Port the Express server listens on.
PORT=3000
