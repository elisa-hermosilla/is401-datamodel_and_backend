<%- include("partials/head", { title: "Admin", description: "DueList admin: users, assignment types, and OKRs.", noindex: true }) %>
  <div class="app">
<%- include("partials/sidebar", { active: "admin", user }) %>

    <main id="main-content" tabindex="-1" class="main settings-page admin-page">
      <div class="page-header">
        <div>
          <h1>Admin</h1>
          <p class="sub">Users, assignment types, and how the app is doing against its goals.</p>
        </div>
      </div>
      <div class="settings-shell" id="settings-shell">
        <nav class="settings-nav" aria-label="Admin categories">
          <% const adminIcons = {
            okrs: '<path d="M4 20V10m6 10V4m6 16v-7"/><path d="M2 20h20"/>',
            users: '<circle cx="9" cy="8" r="4"/><path d="M2 21v-2a7 7 0 0 1 14 0v2"/><path d="M16 3.5a4 4 0 0 1 0 9M22 21v-2a7 7 0 0 0-4-6.3"/>',
            types: '<path d="M20.6 13.4 13.4 20.6a2 2 0 0 1-2.8 0L3 13V3h10l7.6 7.6a2 2 0 0 1 0 2.8z"/><circle cx="7.5" cy="7.5" r="1.5"/>'
          }; %>
          <% for (const [key, label] of [['okrs','OKRs'],['users','Users'],['types','Assignment types']]) { %>
            <a href="#<%= key %>" data-settings-category="<%= key %>"><span class="settings-category-icon" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><%- adminIcons[key] %></svg></span><%= label %><span class="settings-category-arrow" aria-hidden="true">›</span></a>
          <% } %>
        </nav>
        <div class="settings-detail">
          <button type="button" class="btn btn-ghost settings-back" id="settings-back">‹ Admin categories</button>
          <div class="settings-grid">

            <!-- OKRs -->
            <section class="settings-category" data-settings-panel="okrs" id="admin-okrs">
              <div class="okr-objective" id="okr-objective-1">
                <span class="okr-kicker">Objective 1</span>
                <h4>Help users activate and set up their onboarding with ease and swiftness</h4>
              </div>
              <div class="okr-pair">
                <div class="card okr-card" id="kr-tutorial">
                  <div class="card-header">
                    <h3>Time to activate</h3>
                    <span class="okr-target">Target: under 24 hours</span>
                  </div>
                  <div class="stat-grid okr-tiles" id="kr-tutorial-tiles" aria-live="polite"></div>
                  <h4 class="okr-subhead">Sign-up to finishing the navigation tutorial</h4>
                  <div class="meter-list" id="kr-tutorial-buckets"></div>
                </div>
                <div class="card okr-card" id="kr-sync">
                  <div class="card-header">
                    <h3>First sync</h3>
                    <span class="okr-target">Target: 15 minutes or less</span>
                  </div>
                  <div class="stat-grid okr-tiles" id="kr-sync-tiles" aria-live="polite"></div>
                  <h4 class="okr-subhead">Sign-up to the first class sync</h4>
                  <div class="meter-list" id="kr-sync-buckets"></div>
                </div>
              </div>

              <div class="okr-objective" id="okr-objective-2">
                <span class="okr-kicker">Objective 2</span>
                <h4>Retain users in this product and continue to use it</h4>
                <div class="okr-toolbar">
                  <label class="visually-hidden" for="okr-range">Chart range</label>
                  <select class="select" id="okr-range" aria-label="Chart range">
                    <option value="30">Last 30 days</option>
                    <option value="90" selected>Last 90 days</option>
                    <option value="180">Last 180 days</option>
                  </select>
                </div>
              </div>
              <div class="okr-pair">
                <div class="card okr-card" id="kr-churn">
                  <div class="card-header">
                    <h3>First-month churn</h3>
                    <span class="okr-target" id="kr-churn-target">Target: below 33%</span>
                  </div>
                  <div class="stat-grid okr-tiles" id="kr-churn-tiles" aria-live="polite"></div>
                  <div class="okr-charts single">
                    <figure class="okr-chart" id="chart-churn">
                      <figcaption>Churn rate as of each day</figcaption>
                      <div class="okr-chart-body"></div>
                    </figure>
                  </div>
                </div>
                <div class="card okr-card" id="kr-streaks">
                  <div class="card-header">
                    <h3>5-day streaks</h3>
                    <span class="okr-target">Counted once per run</span>
                  </div>
                  <div class="stat-grid okr-tiles" id="kr-streaks-tiles" aria-live="polite"></div>
                  <div class="okr-charts single">
                    <figure class="okr-chart" id="chart-streaks">
                      <figcaption>Streaks reached, running total</figcaption>
                      <div class="okr-chart-body"></div>
                    </figure>
                  </div>
                </div>
              </div>
            </section>

            <!-- Users: add, edit (including admin access), delete -->
            <section class="settings-category" data-settings-panel="users" id="admin-users" hidden>
              <div class="card users-card">
                <div class="card-header">
                  <div>
                    <h3>Users</h3>
                    <p class="sub" id="users-sub">Add, edit, or delete accounts. Admin access is set when you edit a user.</p>
                  </div>
                  <button type="button" class="btn btn-primary btn-sm" id="user-add">Add user</button>
                </div>
                <div class="user-tools">
                  <label class="visually-hidden" for="user-search">Search users</label>
                  <input class="input" type="search" id="user-search" placeholder="Search name, username, or email" autocomplete="off">
                  <div class="chips" id="user-filter" role="group" aria-label="Show">
                    <button type="button" class="chip active" data-filter="all" aria-pressed="true">All</button>
                    <button type="button" class="chip" data-filter="admin" aria-pressed="false">Admins</button>
                    <button type="button" class="chip" data-filter="non-admin" aria-pressed="false">Non-admins</button>
                  </div>
                </div>
                <div class="admin-user-list" id="user-list"></div>
              </div>
            </section>

            <!-- Assignment types: the global list a class category maps to -->
            <section class="settings-category" data-settings-panel="types" id="admin-types" hidden>
              <div class="card types-card">
                <div class="card-header">
                  <div>
                    <h3>Assignment types</h3>
                    <p class="sub" id="types-sub">The kinds of work a class category can be mapped to. Built-in types are used by syncing and can't be changed.</p>
                  </div>
                </div>
                <form class="type-add" id="type-form" novalidate>
                  <label class="visually-hidden" for="type-name">New type name</label>
                  <input class="input" id="type-name" placeholder="New type, e.g. lab report" maxlength="50" autocomplete="off">
                  <button type="submit" class="btn btn-primary btn-sm" id="type-add">Add type</button>
                </form>
                <div class="form-error" id="type-error" role="alert"></div>
                <div class="admin-user-list admin-type-list" id="type-list"></div>
              </div>
            </section>

          </div>
        </div>
      </div>
    </main>
  </div>

  <!-- Add / edit user -->
  <div class="modal-backdrop" id="user-modal">
    <div class="modal" role="dialog" aria-modal="true" aria-labelledby="user-modal-title">
      <h3 id="user-modal-title">Add user</h3>
      <form id="user-form" novalidate>
        <div class="form-error" id="user-error" role="alert"></div>
        <div class="row user-name-row">
          <div class="field">
            <label for="u-first">First name</label>
            <input class="input" id="u-first" maxlength="100" autocomplete="off">
          </div>
          <div class="field">
            <label for="u-last">Last name</label>
            <input class="input" id="u-last" maxlength="100" autocomplete="off">
          </div>
        </div>
        <div class="field">
          <label for="u-username">Username</label>
          <input class="input" id="u-username" maxlength="50" autocomplete="off">
        </div>
        <div class="field">
          <label for="u-email">Email</label>
          <input class="input" id="u-email" type="email" maxlength="255" autocomplete="off">
        </div>
        <div class="field">
          <label for="u-password" id="u-password-label">Password</label>
          <input class="input" id="u-password" type="password" autocomplete="new-password">
          <span class="hint" id="u-password-hint">At least 8 characters.</span>
        </div>
        <div class="field">
          <div class="admin-switch-row">
            <div>
              <label for="u-admin">Admin</label>
              <span class="hint" id="u-admin-hint">Admins can open this page and manage users and types.</span>
            </div>
            <label class="switch"><input type="checkbox" id="u-admin" aria-label="Admin access"><span class="slider"></span></label>
          </div>
        </div>
        <div class="modal-actions">
          <button type="button" class="btn btn-secondary" data-close="user-modal">Cancel</button>
          <button type="submit" class="btn btn-primary" id="user-save">Add user</button>
        </div>
      </form>
    </div>
  </div>

  <!-- Delete user / delete type confirm -->
  <div class="modal-backdrop" id="confirm-modal">
    <div class="modal" role="dialog" aria-modal="true" aria-labelledby="confirm-title">
      <h3 id="confirm-title">Delete</h3>
      <p class="confirm-text" id="confirm-text"></p>
      <div class="form-error" id="confirm-error" role="alert"></div>
      <div class="modal-actions">
        <button type="button" class="btn btn-secondary" data-close="confirm-modal">Cancel</button>
        <button type="button" class="btn btn-danger" id="confirm-delete">Delete</button>
      </div>
    </div>
  </div>
<%- include("partials/scripts", { scripts: ["api", "data", "app", "admin"] }) %>
