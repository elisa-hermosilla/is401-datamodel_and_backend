<%- include("partials/head", { title: "Admin", description: "DueList admin: user management and OKRs.", noindex: true }) %>
  <div class="app">
<%- include("partials/sidebar", { active: "admin", user }) %>

    <main id="main-content" tabindex="-1" class="main settings-page admin-page">
      <div class="page-header">
        <div>
          <h1>Admin</h1>
          <p class="sub">Who can manage DueList, and how the app is doing against its goals.</p>
        </div>
      </div>
      <div class="settings-shell" id="settings-shell">
        <nav class="settings-nav" aria-label="Admin categories">
          <% const adminIcons = {
            okrs: '<path d="M4 20V10m6 10V4m6 16v-7"/><path d="M2 20h20"/>',
            users: '<circle cx="9" cy="8" r="4"/><path d="M2 21v-2a7 7 0 0 1 14 0v2"/><path d="M16 3.5a4 4 0 0 1 0 9M22 21v-2a7 7 0 0 0-4-6.3"/>'
          }; %>
          <% for (const [key, label] of [['okrs','OKRs'],['users','Users']]) { %>
            <a href="#<%= key %>" data-settings-category="<%= key %>"><span class="settings-category-icon" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><%- adminIcons[key] %></svg></span><%= label %><span class="settings-category-arrow" aria-hidden="true">›</span></a>
          <% } %>
        </nav>
        <div class="settings-detail">
          <button type="button" class="btn btn-ghost settings-back" id="settings-back">‹ Admin categories</button>
          <div class="settings-grid">

            <!-- OKRs -->
            <section class="settings-category" data-settings-panel="okrs" id="admin-okrs">
              <div class="okr-toolbar">
                <label for="okr-range">Chart range</label>
                <select class="select" id="okr-range">
                  <option value="30">Last 30 days</option>
                  <option value="90" selected>Last 90 days</option>
                  <option value="180">Last 180 days</option>
                </select>
              </div>

              <div class="card">
                <div class="card-header">
                  <div>
                    <h3>User retention</h3>
                    <p class="sub">A user is active when they opened DueList in the past 30 days. Days per week counts the distinct days each active user came back, averaged across them.</p>
                  </div>
                </div>
                <div class="stat-grid okr-tiles" id="retention-tiles" aria-live="polite"></div>
                <div class="okr-charts">
                  <figure class="okr-chart" id="chart-active">
                    <figcaption>Active in the past 30 days (% of accounts)</figcaption>
                    <div class="okr-chart-body"></div>
                  </figure>
                  <figure class="okr-chart" id="chart-days">
                    <figcaption>Days per week among active users</figcaption>
                    <div class="okr-chart-body"></div>
                  </figure>
                </div>
                <p class="sub okr-note" id="retention-note"></p>
                <details class="okr-table">
                  <summary>Show as a table</summary>
                  <div class="okr-table-scroll"><table id="retention-table"></table></div>
                </details>
              </div>

              <div class="card">
                <div class="card-header">
                  <div>
                    <h3>Quick start setup</h3>
                    <p class="sub">How many accounts finish the quick start, and how long it takes them from creating the account to clicking Finish. Accounts that existed before the quick start was added finished it days later, which pulls the average up; the median is the fairer read.</p>
                  </div>
                </div>
                <div class="stat-grid okr-tiles" id="setup-tiles" aria-live="polite"></div>
                <h4 class="okr-subhead">Time to finish</h4>
                <div class="meter-list" id="setup-buckets"></div>
              </div>
            </section>

            <!-- Users -->
            <section class="settings-category" data-settings-panel="users" id="admin-users" hidden>
              <div class="card">
                <div class="card-header">
                  <div>
                    <h3>Users</h3>
                    <p class="sub" id="users-sub">Admins can open this page and grant or remove admin access.</p>
                  </div>
                </div>
                <div class="admin-user-list" id="user-list"></div>
              </div>
            </section>

          </div>
        </div>
      </div>
    </main>
  </div>
<%- include("partials/scripts", { scripts: ["api", "data", "app", "admin"] }) %>
