<%- include("partials/head", { title: "Assignments", description: "Manage your classes and the assignments DueList imports or tracks for you.", noindex: true }) %>
  <div class="app">
<%- include("partials/sidebar", { active: "assignments", user }) %>

    <main id="main-content" tabindex="-1" class="main assignments-page">
      <div class="page-header">
        <div>
          <h1>Assignments</h1>
          <p class="sub">Your classes and the assignments in each. Add, edit, or delete a class.</p>
        </div>
        <div class="toolbar">
          <button type="button" class="btn btn-secondary btn-sm mobile-disclosure" data-mobile-disclosure="class-list-options" aria-expanded="false" aria-controls="class-list-options">List options</button>
          <div class="mobile-filter-panel" id="class-list-options">
          <label style="display:flex;align-items:center;gap:8px;font-size:13px;color:var(--muted)">
            <input type="checkbox" id="show-done"> Show completed
          </label>
          <button type="button" class="btn btn-ghost btn-sm" id="toggle-all-classes" aria-controls="class-grid" disabled>Collapse All</button>
          </div>
          <button class="btn btn-primary" id="add-class-btn">Add Class</button>
        </div>
      </div>

      <div class="class-grid" id="class-grid" aria-busy="true" aria-label="Classes and assignments">
        <% for (let i = 0; i < 3; i++) { %>
          <div class="card assignments-skeleton" aria-hidden="true"><div class="skeleton-heading"></div><div class="skeleton-row"></div><div class="skeleton-row"></div></div>
        <% } %>
      </div>
    </main>
  </div>

  <!-- Add / edit class modal. Step 1: source, code, name, color. Step 2 (Canvas and
       Learning Suite only): map the class's categories to assignment types. -->
  <div class="modal-backdrop" id="class-modal">
    <div class="modal" id="class-modal-box">
      <h3 id="class-modal-title">Add a class</h3>
      <form id="class-form" novalidate>
        <input type="hidden" id="c-id">
        <input type="hidden" id="c-source">
        <input type="hidden" id="c-external-id">
        <input type="hidden" id="c-color">
        <div class="form-error" id="class-error" role="alert"></div>

        <!-- Source first: it decides which fields follow -->
        <div class="field">
          <label>Source</label>
          <div class="chips source-chips" id="c-source-chips"></div>
          <span class="error" id="c-source-error"></span>
        </div>

        <!-- Canvas: pick from the connected account's course list -->
        <div class="source-section" id="c-section-canvas">
          <div class="field">
            <label for="c-canvas-course">Canvas class</label>
            <select class="select" id="c-canvas-course"></select>
            <span class="error" id="c-canvas-course-error"></span>
            <span class="hint" id="c-canvas-note"></span>
          </div>
        </div>

        <!-- Learning Suite: per-course iCalendar feed -->
        <div class="source-section" id="c-section-ls">
          <div class="field">
            <label for="c-ics">iCalendar link</label>
            <div class="row" style="align-items:flex-start">
              <input class="input" id="c-ics" type="url" placeholder="https://learningsuite.byu.edu/.../calendar.ics" maxlength="500">
            <button type="button" class="btn btn-secondary" id="c-ics-check" style="flex:none">Check Link</button>
            </div>
            <span class="error" id="c-ics-error"></span>
            <span class="hint" id="c-ics-note">In Learning Suite open the course, go to Schedule, and copy the iCal link. Syncing pulls every dated item on the schedule.</span>
          </div>
        </div>

        <!-- Manual -->
        <div class="source-section" id="c-section-manual">
          <div class="field"><span class="hint">Manual classes only show assignments you add yourself.</span></div>
        </div>

        <div class="field">
          <label for="c-code">Course code</label>
          <input class="input" id="c-code" placeholder="e.g. MKTG 201" maxlength="30">
          <span class="error" id="c-code-error"></span>
        </div>
        <div class="field">
          <label for="c-name">Course name</label>
          <input class="input" id="c-name" placeholder="e.g. Marketing Management" maxlength="150">
          <span class="error" id="c-name-error"></span>
        </div>
        <div class="field">
          <label>Color</label>
          <div class="color-swatches" id="c-swatches"></div>
        </div>
        <div class="modal-actions">
          <button type="button" class="btn btn-secondary" data-close="class-modal">Cancel</button>
          <button type="submit" class="btn btn-primary" id="class-submit">Add Class</button>
        </div>
      </form>

      <!-- Step 2: category mapping -->
      <div id="class-step-2" style="display:none">
        <p class="sub" id="cat-intro" style="color:var(--muted);font-size:13.5px;margin-bottom:14px"></p>
        <div class="form-error" id="cat-error" role="alert"></div>
        <div id="cat-body"></div>
        <div class="modal-actions">
          <button type="button" class="btn btn-ghost" id="cat-back" style="margin-right:auto">Back</button>
          <button type="button" class="btn btn-secondary" data-close="class-modal">Close</button>
          <button type="button" class="btn btn-primary" id="cat-finish">Finish</button>
        </div>
      </div>
    </div>
  </div>

  <!-- Delete class confirm -->
  <div class="modal-backdrop" id="confirm-modal">
    <div class="modal">
      <h3 id="confirm-title">Delete class</h3>
      <p class="confirm-text" id="confirm-text"></p>
      <div class="form-error" id="confirm-error" role="alert"></div>
      <div class="modal-actions">
        <button type="button" class="btn btn-secondary" data-close="confirm-modal">Cancel</button>
        <button type="button" class="btn btn-danger" id="confirm-delete">Delete</button>
      </div>
    </div>
  </div>

  <!-- The add/edit assignment modal is shared across pages and built by app.js -->
<%- include("partials/scripts", { scripts: ["api", "data", "app", "assignments"] }) %>
