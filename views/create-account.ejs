<%- include("partials/head", { title: "Create account", description: "Create a DueList account to organize your Canvas and Learning Suite assignments." }) %>
  <div class="auth-wrap">
<%- include("partials/auth-hero", { heading: "Create an account.", blurb: "After you create an account you can link Canvas and Learning Suite. DueList imports your classes and assignments from both.", sources: true }) %>

    <section class="auth-panel">
      <div class="auth-card">
        <h2>Create your account</h2>
        <p class="sub">Sign in later with your username or email.</p>

        <form id="create-form" novalidate>
          <div class="form-error" id="create-error" role="alert"></div>
          <div class="row">
            <div class="field">
              <label for="first">First name</label>
              <input class="input" id="first" type="text" placeholder="Cosmo" autocomplete="given-name" maxlength="100">
            </div>
            <div class="field">
              <label for="last">Last name</label>
              <input class="input" id="last" type="text" placeholder="Cougar" autocomplete="family-name" maxlength="100">
            </div>
          </div>
          <div class="field">
            <label for="username">Username</label>
            <input class="input" id="username" type="text" placeholder="cosmocougar" autocomplete="username" maxlength="50">
            <span class="hint">3 to 50 characters: letters, numbers, dots, dashes, or underscores.</span>
          </div>
          <div class="field">
            <label for="email">Email</label>
            <input class="input" id="email" type="email" placeholder="you@example.com" autocomplete="email" maxlength="255">
          </div>
          <div class="field">
            <label for="pass">Password</label>
            <input class="input" id="pass" type="password" placeholder="At least 8 characters" autocomplete="new-password">
          </div>
          <div class="field">
            <label for="pass2">Confirm password</label>
            <input class="input" id="pass2" type="password" placeholder="Re-enter password" autocomplete="new-password">
          </div>
          <button class="btn btn-primary btn-block" type="submit" id="create-btn">Create account</button>
        </form>

        <p class="auth-footer">Already have an account? <a href="/login">Sign in</a></p>
      </div>
    </section>
  </div>
<%- include("partials/scripts", { scripts: ["api", "create-account"] }) %>
