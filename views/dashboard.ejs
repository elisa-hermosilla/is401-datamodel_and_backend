<%- include("partials/head", { title: "Dashboard", description: "See upcoming, overdue, and completed assignments in your DueList dashboard.", noindex: true }) %>
  <div class="app overview-app">
<%- include("partials/sidebar", { active: "dashboard", user }) %>
    <main id="main-content" tabindex="-1" class="main overview-main dashboard-main is-loading">
      <header class="page-header">
        <div><h1 id="greeting">Dashboard</h1><p class="sub" id="today-line"></p></div>
        <div class="toolbar">
          <a class="btn btn-secondary btn-sm" href="/calendar">View calendar</a>
          <button class="btn btn-primary btn-sm" id="add-assignment">Add assignment</button>
        </div>
      </header>

      <div class="stat-grid overview-stats" id="stat-grid" aria-label="Filter assignments by due date"></div>

      <div class="dashboard-layout">
        <section class="card queue-panel" aria-labelledby="queue-heading">
          <div class="card-header">
            <div class="queue-heading"><h2 id="queue-heading">Assignments</h2><button class="text-button" id="all-open" aria-pressed="true">All open</button></div>
            <label class="check-label dashboard-completed"><input type="checkbox" id="show-done"> Include completed</label>
            <button type="button" class="btn btn-secondary btn-sm mobile-dashboard-control" id="toggle-dashboard-filters" aria-expanded="false" aria-controls="dashboard-filters">Search &amp; filters</button>
          </div>
          <div id="dashboard-filters" class="dashboard-filters">
          <div class="queue-controls">
            <input class="input" id="assignment-search" type="search" aria-label="Search assignments" placeholder="Search name, class, submission, or type" title="Press / to search">
            <select class="select" id="f-class" aria-label="Filter by class"></select>
            <select class="select" id="f-type" aria-label="Filter by assignment type"></select>
            <select class="select" id="sort" aria-label="Sort assignments">
              <option value="due">Due date</option><option value="class">Class</option>
              <option value="type">Type</option><option value="custom">Custom order</option>
            </select>
          </div>
          </div>
          <div class="queue-context"><span id="queue-scope">All open assignments</span><div class="active-filters" id="active-filters"></div><button type="button" class="btn btn-ghost btn-sm reset-order" id="reset-order" style="display:none" title="Clear your custom order">Reset order</button></div>
          <div class="compact-list" id="assignment-list"></div>
          <div class="list-footer">
            <span id="filter-count" role="status"></span>
            <button type="button" class="btn btn-secondary btn-sm mobile-dashboard-control" id="dashboard-show-more" hidden>Show more</button>
          </div>
        </section>

        <button type="button" class="btn btn-secondary mobile-dashboard-control" id="toggle-dashboard-overview" aria-expanded="false" aria-controls="dashboard-overview">Weekly overview &amp; streaks</button>
        <aside id="dashboard-overview" class="dashboard-rail" aria-label="Planning overview">
          <section class="card focus-card" id="next-grid" aria-label="Next deadline"></section>
          <section class="card week-card" aria-labelledby="week-heading">
            <div class="card-header"><h2 id="week-heading">Next 7 days</h2><a class="subtle-link" href="/calendar">Calendar ↗</a></div>
            <div class="week-strip" id="week-strip"></div>
            <p class="workload-summary" id="week-summary"></p>
            <div class="week-progress" id="week-progress"></div>
          </section>
          <section class="streak-row" id="streak-row" aria-label="Streaks"></section>
        </aside>
      </div>
    </main>
  </div>
  <div class="modal-backdrop" id="onboarding-modal" aria-hidden="true">
    <section class="modal onboarding-modal" role="dialog" aria-modal="true" aria-labelledby="onboarding-title">
      <div id="onboarding-content"></div>
      <div class="onboarding-footer">
        <button type="button" class="btn btn-ghost btn-sm" id="onboarding-skip">Skip tutorial</button>
        <div class="onboarding-actions" id="onboarding-actions"></div>
      </div>
    </section>
  </div>
<%- include("partials/scripts", { scripts: ["api", "data", "app", "dashboard", "onboarding"] }) %>
