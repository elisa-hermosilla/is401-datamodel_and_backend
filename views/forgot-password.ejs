<%- include("partials/head", { title: "Reset password", description: "Reset your DueList password and get back to your assignments." }) %>
  <div class="auth-wrap">
<%- include("partials/auth-hero", { heading: "Reset your password.", blurb: "Enter the email on your account and a reset link is sent to it. The link expires in 30 minutes." }) %>

    <section class="auth-panel">
      <div class="auth-card">
        <div id="step1">
          <h2>Reset your password</h2>
          <p class="sub">A link to choose a new password is emailed to you.</p>
          <!-- Mock for this milestone: no email is sent. -->
          <form id="reset-form" novalidate>
            <div class="form-error" id="reset-error" role="alert"></div>
            <div class="field">
              <label for="email">Email</label>
              <input class="input" id="email" type="email" placeholder="netid@byu.edu">
            </div>
            <button class="btn btn-primary btn-block" type="submit">Send reset link</button>
          </form>
          <p class="auth-footer"><a href="/login">Back to sign in</a></p>
        </div>

        <div id="step2" style="display:none">
          <div style="width:56px;height:56px;border-radius:16px;background:var(--ok-bg);color:var(--ok);display:grid;place-items:center;margin-bottom:18px">
            <svg viewBox="0 0 24 24" width="28" height="28" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>
          </div>
          <h2>Check your inbox</h2>
          <p class="sub">If an account exists for that email, a reset link is on its way.</p>
          <a class="btn btn-primary btn-block" href="/login">Back to sign in</a>
          <p class="auth-footer">Didn't get it? <a href="#" id="resend">Resend email</a></p>
        </div>
      </div>
    </section>
  </div>

  <script>
    document.getElementById("reset-form").addEventListener("submit", e => {
      e.preventDefault();
      const err = document.getElementById("reset-error");
      if (!document.getElementById("email").value.trim()) { err.textContent = "Enter your email."; err.classList.add("show"); return; }
      document.getElementById("step1").style.display = "none";
      document.getElementById("step2").style.display = "block";
    });
    document.getElementById("resend").addEventListener("click", e => { e.preventDefault(); alert("Reset link resent (demo)."); });
  </script>
</body>
</html>
