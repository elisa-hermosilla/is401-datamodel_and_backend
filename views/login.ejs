<%- include("partials/head", { title: "Sign in", description: "Sign in to DueList to manage your Canvas and Learning Suite assignments in one place." }) %>
  <main class="auth-login">
    <div class="login-shell">
      <section class="login-intro" aria-labelledby="login-heading">
        <div class="brand"><span class="brand-mark" aria-hidden="true">D</span> DueList</div>
        <div class="login-intro-copy">
          <p class="login-eyebrow">LESS JUGGLING. MORE DOING.</p>
          <h1 id="login-heading">All your assignments.<br>One clear view.</h1>
          <p class="login-description login-description-full">Bring your BYU Canvas and Learning Suite assignments together in one dashboard, with a calendar and reminders to keep you on track.</p>
          <p class="login-description login-description-compact">Your BYU assignments, calendar, and reminders. Together in one place.</p>
          <div class="hero-sources" aria-label="Assignment sources">
            <span class="source-pill"><span class="source-dot canvas-dot" aria-hidden="true"></span>Canvas</span>
            <span class="source-pill"><span class="source-dot ls-dot" aria-hidden="true"></span>Learning Suite</span>
          </div>
        </div>
        <p class="login-intro-footer">A little more organized. A lot more on top of it.</p>
      </section>

    <section class="auth-panel">
      <div class="auth-card">
        <h2>Welcome back</h2>
        <p class="sub">Sign in to your DueList account.</p>

        <form id="login-form" novalidate>
          <div class="form-error" id="login-error" role="alert"></div>
          <div class="field">
            <label for="user">Username or email</label>
            <input class="input" id="user" type="text" placeholder="Username or email address" autocomplete="username" autocapitalize="none" spellcheck="false">
          </div>
          <div class="field">
            <div class="between">
              <label for="pass">Password</label>
              <a href="/forgot-password" class="login-forgot">Forgot password?</a>
            </div>
            <input class="input" id="pass" type="password" placeholder="Password" autocomplete="current-password">
          </div>
          <div class="login-remember">
            <label for="keep-signed-in">
              <input type="checkbox" id="keep-signed-in" checked> Keep me signed in
            </label>
          </div>
          <button class="btn btn-primary btn-block" type="submit" id="login-btn">Sign in</button>
        </form>

        <div class="divider">or</div>
        <a class="btn btn-secondary btn-block" href="/create-account">Create account</a>

        <p class="auth-footer">Your next deadline, all in one place.</p>
      </div>
    </section>
    </div>
  </main>
<%- include("partials/scripts", { scripts: ["api", "login"] }) %>
