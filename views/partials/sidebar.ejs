<%# App sidebar. Locals: active (dashboard | calendar | assignments | settings), user (row from app_user).
    app.js binds the Sync and Sign out buttons and fills .sync-note after the page loads. %>
<%
  const initials = ((user.first_name || "")[0] || "") + ((user.last_name || "")[0] || "");
-%>
    <a class="skip-link" href="#main-content">Skip to content</a>
    <header class="mobile-header">
      <a class="brand" href="/dashboard"><span class="brand-mark" aria-hidden="true">D</span>DueList</a>
      <button type="button" class="btn btn-secondary" id="menu-open" aria-controls="sidebar" aria-expanded="false"><span aria-hidden="true">☰</span> Menu</button>
    </header>
    <div class="nav-scrim" id="nav-scrim" hidden></div>
    <aside id="sidebar" class="sidebar" aria-label="Main navigation">
      <button type="button" class="btn btn-secondary mobile-menu-close" id="menu-close">Close menu <span aria-hidden="true">×</span></button>
      <a class="brand" href="/dashboard" aria-label="DueList dashboard"><span class="brand-mark">D</span><span>DueList</span></a>
      <nav class="nav" aria-label="Main pages">
        <a href="/dashboard" aria-label="Dashboard"<% if (active === "dashboard") { %> aria-current="page" class="active"<% } %>><svg aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="7" height="9" rx="1.5"/><rect x="14" y="3" width="7" height="5" rx="1.5"/><rect x="14" y="12" width="7" height="9" rx="1.5"/><rect x="3" y="16" width="7" height="5" rx="1.5"/></svg><span>Dashboard</span></a>
        <a href="/calendar" aria-label="Calendar"<% if (active === "calendar") { %> aria-current="page" class="active"<% } %>><svg aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="4" width="18" height="18" rx="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/></svg><span>Calendar</span></a>
        <a href="/assignments" aria-label="Assignments"<% if (active === "assignments") { %> aria-current="page" class="active"<% } %>><svg aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 6h11M9 12h11M9 18h11"/><path d="M4 6h.01M4 12h.01M4 18h.01"/></svg><span>Assignments</span></a>
        <a href="/settings" aria-label="Settings"<% if (active === "settings") { %> aria-current="page" class="active"<% } %>><svg aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="3"/><path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 1 1-2.83 2.83l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 1 1-4 0v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 1 1-2.83-2.83l.06-.06A1.65 1.65 0 0 0 4.6 15a1.65 1.65 0 0 0-1.51-1H3a2 2 0 1 1 0-4h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 1 1 2.83-2.83l.06.06A1.65 1.65 0 0 0 9 4.6a1.65 1.65 0 0 0 1-1.51V3a2 2 0 1 1 4 0v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 1 1 2.83 2.83l-.06.06A1.65 1.65 0 0 0 19.4 9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 1 1 0 4h-.09a1.65 1.65 0 0 0-1.51 1z"/></svg><span>Settings</span></a>
      </nav>
      <div class="sidebar-bottom">
        <button type="button" class="btn btn-secondary btn-block btn-sm" id="sync-btn" aria-label="Sync assignments"><svg aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><polyline points="23 4 23 10 17 10"/><polyline points="1 20 1 14 7 14"/><path d="M3.51 9a9 9 0 0 1 14.85-3.36L23 10M1 14l4.64 4.36A9 9 0 0 0 20.49 15"/></svg> Sync now</button>
        <div class="sync-note"></div>
        <div class="user-chip">
          <div class="avatar"><%= initials %></div>
          <div style="flex:1;min-width:0">
            <div class="name"><%= user.first_name %> <%= user.last_name %></div>
            <div class="email"><%= user.email || user.username %></div>
          </div>
          <button type="button" class="btn btn-ghost btn-icon" id="logout-btn" title="Sign out" aria-label="Sign out"><svg aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"/><polyline points="16 17 21 12 16 7"/><line x1="21" y1="12" x2="9" y2="12"/></svg></button>
        </div>
      </div>
    </aside>
