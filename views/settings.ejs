<%- include("partials/head", { title: "Settings", description: "Manage your DueList account, assignment reminders, notifications, and connected services.", noindex: true }) %>
  <div class="app">
<%- include("partials/sidebar", { active: "settings", user }) %>

    <main id="main-content" tabindex="-1" class="main settings-page">
      <div class="page-header">
        <div>
          <h1>Settings</h1>
          <p class="sub">Manage your account, notifications, and classes.</p>
        </div>
      </div>
      <div class="settings-shell" id="settings-shell">
        <nav class="settings-nav" aria-label="Settings categories">
          <% const settingsIcons = {
            account: '<circle cx="12" cy="8" r="4"/><path d="M4 21v-2a8 8 0 0 1 16 0v2"/>',
            password: '<rect x="4" y="10" width="16" height="11" rx="2"/><path d="M8 10V6a4 4 0 0 1 8 0v4m-4 5v2"/>',
            notifications: '<path d="M18 8a6 6 0 0 0-12 0c0 7-3 7-3 9h18c0-2-3-2-3-9m-9 12a3 3 0 0 0 6 0"/>',
            delivery: '<path d="m22 2-7 20-4-9L2 9 22 2ZM22 2 11 13"/>',
            'connected-accounts': '<path d="m10 13 4-4m-5 7-2 2a4 4 0 0 1-6-6l4-4a4 4 0 0 1 6 0m2 0 2-2a4 4 0 0 1 6 6l-4 4a4 4 0 0 1-6 0"/>',
            classes: '<path d="M12 5C9 3 5 3 2 4v16c3-1 7-1 10 1 3-2 7-2 10-1V4c-3-1-7-1-10 1Zm0 0v16"/>'
          }; %>
          <% for (const [key, label] of [['account','Account'],['password','Password'],['notifications','Reminders'],['delivery','Notifications'],['connected-accounts','Connected Accounts'],['classes','Classes']]) { %>
            <a href="#<%= key %>" data-settings-category="<%= key %>"><span class="settings-category-icon" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><%- settingsIcons[key] %></svg></span><%= label %><span class="settings-category-arrow" aria-hidden="true">›</span></a>
          <% } %>
        </nav>
        <div class="settings-detail">
          <button type="button" class="btn btn-ghost settings-back" id="settings-back">‹ Settings categories</button>
      <div class="settings-grid">

        <!-- Account -->
        <section class="settings-category" data-settings-panel="account" id="settings-account"><div class="card">
          <div class="card-header">
            <div>
              <h3>Account</h3>
              <p class="sub" id="account-sub"></p>
            </div>
          </div>
          <div class="settings-profile-banner"><span class="settings-profile-avatar" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"><circle cx="12" cy="8" r="4"/><path d="M4 21v-2a8 8 0 0 1 16 0v2"/></svg></span><div><strong>Your DueList account</strong><p>Your profile information, all in one place.</p></div></div>
          <dl class="account-details"><div><dt>Name</dt><dd id="account-name"></dd></div><div><dt>Username</dt><dd id="account-username"></dd></div><div><dt>Email</dt><dd id="account-email"></dd></div></dl>
        </div></section>
        <section class="settings-category" data-settings-panel="password" id="settings-password" hidden><div class="card"><div class="card-header"><h3>Password</h3></div>
          <form id="password-form" novalidate class="settings-password-form">
            <div class="setting-row" style="padding-top:0">
              <div class="info">
                <div class="t">Change password</div>
                <div class="d">You stay signed in after changing it.</div>
              </div>
            </div>
            <div class="form-error" id="password-error" role="alert"></div>
            <div class="field">
              <label for="pw-current">Current password</label>
              <input class="input" id="pw-current" type="password" autocomplete="current-password">
            </div>
            <div class="field">
              <label for="pw-new">New password</label>
              <input class="input" id="pw-new" type="password" placeholder="At least 8 characters" autocomplete="new-password">
            </div>
            <div class="field">
              <label for="pw-confirm">Confirm new password</label>
              <input class="input" id="pw-confirm" type="password" autocomplete="new-password">
            </div>
            <button class="btn btn-secondary" type="submit" id="pw-btn">Change password</button>
          </form>
        </div>

        </section>
        <section class="settings-category" data-settings-panel="notifications" id="settings-notifications" hidden>
        <!-- Summary notifications -->
        <div class="card">
          <div class="card-header">
            <div>
              <h3>Summary notifications</h3>
              <p class="sub">A browser push digest of what's due, sent on the days and Mountain Time you choose.</p>
            </div>
            <label class="switch"><input type="checkbox" id="summary-on" aria-label="Enable summary notifications" checked><span class="slider"></span></label>
          </div>
          <div id="summary-body">
            <div class="setting-row">
              <div class="info">
                <div class="t">Days of the week</div>
                <div class="d">Which days the summary is sent.</div>
              </div>
            </div>
            <div class="chips" id="dow-chips"></div>
            <div class="setting-row">
              <div class="info">
                <div class="t">Time of day</div>
                <div class="d">When the summary arrives on those days (Mountain Time).</div>
              </div>
              <div class="control">
                <label class="visually-hidden" for="summary-time">Summary notification time</label>
                <input class="input" type="time" id="summary-time" value="07:30">
              </div>
            </div>
            <div class="setting-row">
              <div class="info">
                <div class="t">Include in summary</div>
                <div class="d">What the digest covers.</div>
              </div>
              <div class="control">
                <label class="visually-hidden" for="summary-range">Assignments to include in summary</label>
                <select class="select" id="summary-range">
                  <option value="today">Due today</option>
                  <option value="today_tomorrow" selected>Due today &amp; tomorrow</option>
                  <option value="next_7_days">Due in the next 7 days</option>
                </select>
              </div>
            </div>
            <div class="callout" id="summary-preview"></div>
          </div>
        </div>

        <!-- Assignment reminders -->
        <div class="card">
          <div class="card-header">
            <div>
              <h3>Assignment reminders</h3>
              <p class="sub">A reminder before each assignment is due.</p>
            </div>
            <label class="switch"><input type="checkbox" id="reminders-on" aria-label="Enable assignment reminders" checked><span class="slider"></span></label>
          </div>
          <div id="reminders-body">
            <div class="setting-row">
              <div class="info">
                <div class="t">Remind me before it's due</div>
                <div class="d">Choose one or more reminder points.</div>
              </div>
            </div>
            <div class="chips" id="hours-chips"></div>
            <div class="row" style="margin-top:12px;max-width:420px">
              <label class="visually-hidden" for="custom-amount">Custom reminder amount</label>
              <input class="input" type="number" id="custom-amount" min="1" max="999" placeholder="Custom amount">
              <label class="visually-hidden" for="custom-unit">Custom reminder unit</label>
              <select class="select" id="custom-unit" style="flex:none;width:auto">
                <option value="1">minutes</option>
                <option value="60" selected>hours</option>
                <option value="1440">days</option>
              </select>
              <button class="btn btn-secondary" id="add-hours" style="flex:none">Add</button>
            </div>

            <div class="setting-row" style="margin-top:8px">
              <div class="info">
                <div class="t">Quiet hours</div>
                <div class="d">Pause notifications during these Mountain Time hours. Time inside quiet hours is skipped when counting down to a reminder, so the reminder arrives before quiet hours start.</div>
              </div>
              <div class="control">
                <label class="switch"><input type="checkbox" id="dnd-on" aria-label="Enable quiet hours" checked><span class="slider"></span></label>
              </div>
            </div>
            <div class="row" id="dnd-times" style="max-width:420px">
              <div class="field" style="margin:0">
                <label for="dnd-start">Quiet from</label>
                <input class="input" type="time" id="dnd-start" value="23:00">
              </div>
              <div class="field" style="margin:0">
                <label for="dnd-end">Until</label>
                <input class="input" type="time" id="dnd-end" value="08:00">
              </div>
            </div>

            <!-- Live example -->
            <div class="callout" id="dnd-example"></div>
            <div id="dnd-timeline"></div>
          </div>
        </div>

        </section>
        <section class="settings-category" data-settings-panel="delivery" id="settings-delivery" hidden>
        <!-- Notifications -->
        <div class="card">
          <div class="card-header">
            <div>
              <h3>Notifications</h3>
              <p class="sub">Manage browser push notifications.</p>
            </div>
          </div>
          <div class="setting-row">
            <div class="info"><div class="t">Push notifications</div><div class="d">Assignment reminders on this account's subscribed browsers.</div><div class="d" id="push-status" aria-live="polite">Checking push support…</div></div>
            <div class="control">
              <label class="switch"><input type="checkbox" id="push-on" aria-label="Enable push notifications"><span class="slider"></span></label>
              <button class="btn btn-secondary btn-sm" id="push-test" type="button" disabled>Send test</button>
            </div>
          </div>
        </div>

        </section>
        <section class="settings-category" data-settings-panel="connected-accounts" id="settings-connections" hidden>
        <!-- Connected accounts -->
        <div class="card" id="connected-accounts">
          <div class="card-header">
            <div>
              <h3>Connected accounts</h3>
              <p class="sub">Sources DueList imports from.</p>
            </div>
          </div>
          <!-- Canvas: real. Rendered by settings.js from GET /api/canvas/status -->
          <div id="canvas-row"></div>
          <!-- Learning Suite: real. Rendered by settings.js from GET /api/learning-suite/status -->
          <div id="ls-row"></div>
        </div>

        </section>
        <section class="settings-category" data-settings-panel="classes" id="settings-classes" hidden>
          <div class="card"><div class="card-header"><h3>Classes</h3><a class="btn btn-secondary btn-sm" href="/assignments?add_class=1">Add class</a></div>
          <div id="settings-class-list"></div><a class="btn btn-ghost btn-sm" href="/assignments">Manage all classes</a></div>
        </section>
      </div>
      <div class="settings-actions" id="settings-save-actions" hidden>
        <button class="btn btn-primary" id="save">Save Changes</button>
      </div>
        </div>
      </div>
    </main>
  </div>
<%- include("partials/scripts", { scripts: ["api", "data", "app", "settings"] }) %>
